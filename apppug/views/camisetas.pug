doctype html
html(lang='pt-BR')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Camisetas
    style
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: Arial, sans-serif;
        background-color: #f5f5f5;
        padding: 20px;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
      }
      h1 {
        text-align: center;
        margin-bottom: 30px;
        color: #333;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      }
      th {
        background-color: #3498db;
        color: white;
        padding: 15px;
        text-align: left;
        font-weight: bold;
      }
      td {
        padding: 12px 15px;
        border-bottom: 1px solid #ddd;
      }
      tr:hover {
        background-color: #f9f9f9;
      }
      .acao-botoes {
        display: flex;
        gap: 10px;
      }
      button {
        padding: 8px 15px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.3s;
      }
      .btn-comprar {
        background-color: #27ae60;
        color: white;
      }
      .btn-comprar:hover {
        background-color: #229954;
      }
      .btn-detalhes {
        background-color: #3498db;
        color: white;
      }
      .btn-detalhes:hover {
        background-color: #2980b9;
      }
  body
    .container
      h1 Camisetas
      if camisetas && camisetas.length > 0
        table
          thead
            tr
              th ID
              th Nome
              th Descrição
              th Quantidade
              th Valor Unitário
              th Ações
          tbody
            each camiseta in camisetas
              tr
                td= camiseta.id
                td= camiseta.nome
                td= camiseta.descrição
                td= camiseta.quantidade
                td= 'R$ ' + camiseta.valhorUnitario
                td
                  .acao-botoes
                    button.btn-detalhes Detalhes
                    button.btn-comprar Comprar
      else
        p(style='text-align: center; color: #999;') Nenhuma camiseta disponível.
